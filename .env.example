# Copy this file to .env and fill in values for your environment

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/fhirdb
DB_USERNAME=fhir
DB_PASSWORD=changeme

# --- AAA Provider (defaults work with the bundled Keycloak docker-compose) ---
# Keycloak (realm-level):
AAA_JWKS_URI=http://localhost:8180/realms/fhir/protocol/openid-connect/certs
AAA_ISSUER_URI=http://localhost:8180/realms/fhir
AAA_AUDIENCES=fhir-server

# Auth0 example:
# AAA_JWKS_URI=https://<domain>/.well-known/jwks.json
# AAA_ISSUER_URI=https://<domain>/

# Okta example:
# AAA_JWKS_URI=https://<domain>/oauth2/default/v1/keys
# AAA_ISSUER_URI=https://<domain>/oauth2/default

# Azure AD example:
# AAA_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# AAA_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0

# AWS Cognito example:
# AAA_JWKS_URI=https://cognito-idp.<region>.amazonaws.com/<pool-id>/.well-known/jwks.json
# AAA_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<pool-id>

# --- RBAC claim configuration ---
# Keycloak realm roles:    realm_access.roles
# Keycloak client roles:   resource_access.<clientId>.roles
# Auth0 / Azure AD / Okta: roles
# AWS Cognito:             cognito:groups
RBAC_ROLES_CLAIM=realm_access.roles

# JWT claim that carries the SMART scope string (default: scope)
RBAC_SCOPE_CLAIM=scope

# JWT claim that carries the patient context ID for SMART patient launch
RBAC_PATIENT_CLAIM=patient

# Whether to also check the local DB for role assignments (true/false)
RBAC_DB_ROLES_ENABLED=true

# --- Keycloak admin (for docker-compose only) ---
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Admin UI OAuth2 client ---
# The admin UI uses the Authorization Code flow for browser login.
# The bundled Keycloak realm configures 'fhir-server' as a public client (no secret),
# which is acceptable only when the server is behind HTTPS with restricted access.
# For a confidential client (recommended in production), set a secret in Keycloak and
# add it to application.yml under spring.security.oauth2.client.registration.keycloak.client-secret:
# OAUTH2_CLIENT_SECRET=changeme

# --- FHIR server ---
FHIR_BASE_URL=http://localhost:8080/fhir
